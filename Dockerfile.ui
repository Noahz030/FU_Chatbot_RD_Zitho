# Lightweight FastAPI image for Voting UI
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Install minimal deps + curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 -s /sbin/nologin appuser

WORKDIR /app

# Install FastAPI + Uvicorn + requests
RUN pip install --no-cache-dir \
    fastapi==0.109.0 \
    uvicorn==0.27.0 \
    pydantic==2.5.3 \
    requests==2.31.0

# Copy UI app
COPY --chown=appuser:appuser src/arena/voting_ui_simple.py ./src/arena/
COPY --chown=appuser:appuser src/arena/voting_system.py ./src/arena/

USER appuser

# Healthcheck
HEALTHCHECK --interval=15s --timeout=3s --retries=5 --start-period=10s \
    CMD curl -fsS http://localhost:8002/ || exit 1

EXPOSE 8002

CMD ["python", "-m", "uvicorn", \
    "src.arena.voting_ui_simple:app", \
     "--host", "0.0.0.0", \
     "--port", "8002", \
     "--access-log"]
