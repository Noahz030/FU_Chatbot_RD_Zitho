# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION - Arena Voting System
# =============================================================================
#
# Diese Datei ist eine Vorlage für die Production-Umgebung.
# Kopiere sie zu .env und fülle alle Werte aus.
#
# WICHTIG: Niemals diese Datei in Git committen!
#          Verwende stattdessen Azure Key Vault für Secrets!
#
# =============================================================================

# =============================================================================
# 1. DEPLOYMENT & INFRASTRUCTURE
# =============================================================================

# Environment mode (MUST be PRODUCTION for security features)
ENVIRONMENT=PRODUCTION

# Domain name (MUST match your SSL certificate)
# Example: arena.ki-campus.org
DOMAIN_NAME=arena.ki-campus.org

# Debug mode (MUST be false in production)
DEBUG_MODE=false

# =============================================================================
# 2. SECURITY & AUTHENTICATION
# =============================================================================

# PostgreSQL superuser password (CHANGE THIS!)
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=your_very_secure_postgres_password_here_min_32_chars

# Arena API Key (for /arena/* endpoints protection)
# Generate with: openssl rand -hex 32
ARENA_API_KEY=your_very_secure_arena_api_key_here_min_32_chars

# REST API Keys (comma-separated, for /api/* endpoints)
# These are separate from Arena API Key
REST_API_KEYS=your_rest_api_key_1,your_rest_api_key_2,your_rest_api_key_3

# CORS allowed origins (comma-separated)
# IMPORTANT: In production, never use "*"!
CORS_ORIGINS=https://arena.ki-campus.org,https://admin.ki-campus.org

# =============================================================================
# 3. AZURE KEY VAULT (Recommended for Production)
# =============================================================================

# Enable Azure Key Vault for centralized secrets management
# Set to "true" in production (requires Managed Identity on VM)
USE_KEY_VAULT=true

# Azure Key Vault name
# Must match your Key Vault in Azure
KEY_VAULT_NAME=kicwa-keyvault-prod

# Note: When USE_KEY_VAULT=true, the secrets below will be loaded from
# Key Vault using Azure Managed Identity. You don't need to fill them in
# this .env file (but you can for local testing).

# =============================================================================
# 4. AZURE OPENAI (Required)
# =============================================================================

# Azure OpenAI API endpoint
# Format: https://your-resource-name.openai.azure.com/
AZURE_OPENAI_URL=https://your-resource.openai.azure.com/

# Azure OpenAI API key
# Format: Your 32-character API key
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# GPT-4 Deployment name in Azure
# This is the deployment you created for GPT-4
AZURE_OPENAI_GPT4_DEPLOYMENT=gpt-4

# GPT-4 Model name
AZURE_OPENAI_GPT4_MODEL=gpt-4

# Embedding model deployment name
AZURE_OPENAI_EMBEDDER_DEPLOYMENT=text-embedding-3-large

# Embedding model name
AZURE_OPENAI_EMBEDDER_MODEL=text-embedding-3-large

# =============================================================================
# 5. QDRANT VECTOR DATABASE (Required)
# =============================================================================

# Production Qdrant instance URL
# Format: https://your-qdrant-instance.cloud.qdrant.io
PROD_QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io

# Qdrant API key (keep this secure!)
PROD_QDRANT_API_KEY=your_qdrant_api_key_here

# Qdrant collection name (where embeddings are stored)
QDRANT_COLLECTION=web_assistant

# =============================================================================
# 6. ARENA STORAGE (Required)
# =============================================================================

# Path for arena votes storage (inside container, leave as default)
STORAGE_PATH=/data/arena_votes.jsonl

# =============================================================================
# 7. OPTIONAL: AZURE MISTRAL
# =============================================================================

# Azure Mistral endpoint (optional alternative LLM)
# Format: https://your-mistral-resource.openai.azure.com/
AZURE_MISTRAL_URL=

# Azure Mistral API key
AZURE_MISTRAL_KEY=

# =============================================================================
# 8. OPTIONAL: GWDG (Alternative LLM Provider)
# =============================================================================

# GWDG endpoint for Llama3, Qwen2 models (optional)
# Format: https://chat-ai.academiccloud.de/v1
GWDG_URL=https://chat-ai.academiccloud.de/v1

# GWDG API key
GWDG_API_KEY=

# =============================================================================
# 9. OPTIONAL: LANGFUSE (Monitoring & Observability)
# =============================================================================

# Langfuse cloud host for tracing and monitoring
LANGFUSE_HOST=https://cloud.langfuse.com

# Langfuse public key
LANGFUSE_PUBLIC_KEY=

# Langfuse secret key (keep this secure!)
LANGFUSE_SECRET_KEY=

# =============================================================================
# 10. OPTIONAL: DRUPAL CMS (Content Loading)
# =============================================================================

# Drupal base URL for content extraction
DRUPAL_URL=https://ki-campus.org

# Drupal OAuth2 client credentials
DRUPAL_CLIENT_ID=

DRUPAL_CLIENT_SECRET=

# Drupal user credentials (optional, fallback)
DRUPAL_USERNAME=

DRUPAL_PASSWORD=

# =============================================================================
# SECURITY CHECKLIST
# =============================================================================
#
# Before deploying, verify:
#
# [ ] ENVIRONMENT=PRODUCTION (not STAGING or LOCAL)
# [ ] DEBUG_MODE=false
# [ ] DOMAIN_NAME matches your actual domain
# [ ] POSTGRES_PASSWORD is at least 32 characters (use openssl rand -hex 32)
# [ ] ARENA_API_KEY is set and at least 32 characters
# [ ] REST_API_KEYS are strong and unique
# [ ] CORS_ORIGINS restricted to your domains (not "*")
# [ ] USE_KEY_VAULT=true (recommended for production)
# [ ] All required Azure OpenAI credentials filled
# [ ] PROD_QDRANT_URL and PROD_QDRANT_API_KEY configured
# [ ] SSL certificates properly configured
# [ ] This file (.env) is in .gitignore
# [ ] .env file permissions: 600 (chmod 600 .env)
#
# ============================================================================= 

# ============== Logging ==============
LOG_LEVEL=INFO
LOG_FILE=/var/log/arena/app.log

# ============== Security ==============
# TLS Certificates - Place fullchain.pem and privkey.pem in nginx/ssl/
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# Rate Limiting
RATE_LIMIT_GENERAL=30/s
RATE_LIMIT_API=10/s
RATE_LIMIT_VOTE=5/s
