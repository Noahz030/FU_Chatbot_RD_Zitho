# Arena Production Environment Template
# Copy to .env.prod and fill in actual values

# ============== Application ==============
ENVIRONMENT=PRODUCTION
DEBUG_MODE=false

# ============== Azure OpenAI (LLM) ==============
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_URL=https://your-resource.openai.azure.com/
AZURE_OPENAI_GPT4_DEPLOYMENT=gpt-4o
AZURE_OPENAI_GPT4_MODEL=gpt-4o
AZURE_OPENAI_EMBEDDER_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDER_MODEL=text-embedding-3-large

# ============== Qdrant Vector DB ==============
PROD_QDRANT_URL=qdrant-app.example.azurecontainerapps.io
PROD_QDRANT_API_KEY=your-qdrant-api-key-here

# ============== Key Vault (Optional) ==============
USE_KEY_VAULT=false
KEY_VAULT_NAME=your-keyvault-name

# ============== API Configuration ==============
REST_API_KEYS=["key1", "key2"]  # For REST API protection
CORS_ORIGINS=https://arena.example.org  # Your domain

# ============== Langfuse Monitoring (Optional) ==============
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key

# ============== Drupal Integration (Optional) ==============
DRUPAL_URL=https://ki-campus.org
DRUPAL_CLIENT_ID=your-drupal-client-id
DRUPAL_CLIENT_SECRET=your-drupal-client-secret
DRUPAL_USERNAME=your-drupal-username
DRUPAL_PASSWORD=your-drupal-password

# ============== Arena Voting Storage ==============
STORAGE_PATH=/data/arena_votes.jsonl

# ============== Database (PostgreSQL, optional) ==============
POSTGRES_USER=arena_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=arena

# ============== Nginx ==============
NGINX_WORKER_PROCESSES=4
NGINX_WORKER_CONNECTIONS=1024

# ============== Logging ==============
LOG_LEVEL=INFO
LOG_FILE=/var/log/arena/app.log

# ============== Security ==============
# TLS Certificates - Place fullchain.pem and privkey.pem in nginx/ssl/
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# Rate Limiting
RATE_LIMIT_GENERAL=30/s
RATE_LIMIT_API=10/s
RATE_LIMIT_VOTE=5/s
