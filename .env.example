# Environment Configuration für OpenWebUI Arena
# Kopiere diese Datei zu .env und fülle die Werte aus

# Environment
ENVIRONMENT=STAGING
DEBUG_MODE=false

# Azure OpenAI (erforderlich für GPT-4)
AZURE_OPENAI_URL=your-azure-openai-endpoint
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_GPT4_DEPLOYMENT=gpt-4-deployment-name
AZURE_OPENAI_GPT4_MODEL=gpt-4
AZURE_OPENAI_EMBEDDER_DEPLOYMENT=embedder-deployment-name
AZURE_OPENAI_EMBEDDER_MODEL=text-embedding-ada-002

# Azure Mistral (optional)
AZURE_MISTRAL_URL=your-mistral-endpoint
AZURE_MISTRAL_KEY=your-mistral-key

# GWDG (optional, für Llama3 und Qwen2)
GWDG_URL=https://chat-ai.academiccloud.de/v1
GWDG_API_KEY=your-gwdg-key

# Langfuse (Tracing, optional)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=your-public-key
LANGFUSE_SECRET_KEY=your-secret-key

# Qdrant Vector Database
DEV_QDRANT_URL=your-qdrant-url
DEV_QDRANT_API_KEY=your-qdrant-key

# Drupal API (für Daten-Loading)
DRUPAL_URL=https://ki-campus.org
DRUPAL_CLIENT_ID=your-client-id
DRUPAL_CLIENT_SECRET=your-client-secret
DRUPAL_USERNAME=your-username
DRUPAL_PASSWORD=your-password

# REST API Keys (komma-separiert)
REST_API_KEYS=key1,key2,key3
