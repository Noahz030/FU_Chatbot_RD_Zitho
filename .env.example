# Environment Configuration für OpenWebUI Arena
# Kopiere diese Datei zu .env und fülle die Werte aus

# ============================================
# GENERAL CONFIGURATION
# ============================================

# Environment mode (LOCAL, STAGING, PRODUCTION)
ENVIRONMENT=PRODUCTION
DEBUG_MODE=false

# Domain name for SSL certificates and CORS
DOMAIN_NAME=arena.example.com

# ============================================
# SECURITY CONFIGURATION
# ============================================

# PostgreSQL password (CHANGE THIS!)
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Arena API Key for authenticated endpoints (in PRODUCTION mode)
# Generate with: openssl rand -hex 32
ARENA_API_KEY=your_secure_arena_api_key_here

# REST API Keys (comma-separated, for /api/ endpoints)
REST_API_KEYS=key1,key2,key3

# CORS allowed origins (comma-separated, use * for development only)
# Example: https://arena.example.com,https://admin.example.com
CORS_ORIGINS=https://${DOMAIN_NAME}

# ============================================
# AZURE KEY VAULT (Production Secret Management)
# ============================================

# Enable Azure Key Vault for secrets (true in production, false in dev)
USE_KEY_VAULT=false

# Azure Key Vault name (if USE_KEY_VAULT=true)
KEY_VAULT_NAME=kicwa-keyvault-prod

# Note: When USE_KEY_VAULT=true, secrets below will be loaded from Key Vault
# using Azure Managed Identity. No need to fill them in .env file.

# ============================================
# AZURE OPENAI CONFIGURATION
# ============================================

# Azure OpenAI API credentials
AZURE_OPENAI_URL=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key

# Azure OpenAI deployments
AZURE_OPENAI_GPT4_DEPLOYMENT=gpt-4
AZURE_OPENAI_GPT4_MODEL=gpt-4
AZURE_OPENAI_EMBEDDER_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDER_MODEL=text-embedding-3-large

# ============================================
# QDRANT VECTOR DATABASE
# ============================================

# Production Qdrant instance
PROD_QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io
PROD_QDRANT_API_KEY=your_qdrant_api_key

# Development Qdrant (optional, for local testing)
DEV_QDRANT_URL=http://localhost:6333
DEV_QDRANT_API_KEY=

# Collection name
QDRANT_COLLECTION=web_assistant

# ============================================
# ARENA STORAGE CONFIGURATION
# ============================================

# Storage path for arena votes (inside container)
STORAGE_PATH=/data/arena_votes.jsonl

# ============================================
# OPTIONAL: AZURE MISTRAL
# ============================================

# Azure Mistral endpoint (optional)
AZURE_MISTRAL_URL=
AZURE_MISTRAL_KEY=

# ============================================
# OPTIONAL: GWDG (Llama3, Qwen2)
# ============================================

# GWDG endpoint for alternative models (optional)
GWDG_URL=https://chat-ai.academiccloud.de/v1
GWDG_API_KEY=

# ============================================
# OPTIONAL: LANGFUSE (Monitoring & Tracing)
# ============================================

# Langfuse credentials for observability
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ============================================
# OPTIONAL: DRUPAL CMS (Content Loading)
# ============================================

# Drupal API credentials for content loaders
DRUPAL_URL=https://ki-campus.org
DRUPAL_CLIENT_ID=
DRUPAL_CLIENT_SECRET=
DRUPAL_USERNAME=
DRUPAL_PASSWORD=
