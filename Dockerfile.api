# Multi-stage build for optimized API image
# Stage 1: Runtime image
FROM python:3.11-slim

# Set environment variables for production
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Install curl for healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 -s /sbin/nologin appuser

WORKDIR /app

# Create requirements.txt with core dependencies
RUN pip install --upgrade pip && \
    pip install --no-cache-dir \
    fastapi==0.109.0 \
    uvicorn==0.27.0 \
    pydantic==2.5.3 \
    qdrant-client==1.10.1 \
    llama-index==0.10.68 \
    llama-index-embeddings-azure-openai==0.1.11 \
    llama-index-llms-azure-openai==0.1.10 \
    llama-index-llms-openai-like==0.1.3 \
    llama-index-llms-azure-inference==0.1.1 \
    llama-index-callbacks-langfuse==0.1.6 \
    llama-index-vector-stores-qdrant==0.2.14 \
    llamaapi==0.1.36 \
    openai==1.16.2 \
    python-dotenv==1.0.1 \
    webvtt-py==0.4.6 \
    langfuse==2.43.1 \
    azure-identity \
    azure-keyvault-secrets \
    pydantic-settings && \
    python -c "import nltk; nltk.download('punkt_tab', download_dir='/tmp/nltk_data', quiet=True)" && \
    mkdir -p /tmp/nltk_data && chmod -R 777 /tmp/nltk_data

# Set NLTK data path to writable directory
ENV NLTK_DATA=/tmp/nltk_data

# Copy application code
COPY --chown=appuser:appuser src/ ./src/
COPY --chown=appuser:appuser scripts/ ./scripts/

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=15s --timeout=3s --retries=5 --start-period=10s \
    CMD curl -fsS http://localhost:8001/health || exit 1

# Expose API port
EXPOSE 8001

# Run API
CMD ["python", "-m", "uvicorn", \
     "src.openwebui.openwebui_api_llm:app", \
     "--host", "0.0.0.0", \
     "--port", "8001", \
     "--access-log"]
